# Copiá este archivo como .env y completá los valores.
# Conexión a PostgreSQL (por ejemplo, la que te da Neon: https://neon.tech)
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require
# Una frase larga y secreta para firmar los tokens de sesión
JWT_SECRET=cambia-esto-por-algo-largo-y-secreto
# Dirección del frontend, para permitirle llamar a la API (separá varias con coma)
FRONTEND_ORIGIN=http://localhost:5500,https://tuusuario.github.io
PORT=3000
